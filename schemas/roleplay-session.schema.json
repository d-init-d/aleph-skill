{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aleph.local/schemas/1.0/roleplay-session.schema.json",
  "title": "RoleplaySessionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "simulation_id",
    "actors",
    "decision_ticks",
    "allowed_actions",
    "action_effects",
    "payoffs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "simulation_id": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_ticks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "visible_nodes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "history_window": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "allowed_actions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["id", "name"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "cost": {"type": "number", "default": 0.0},
            "noop": {"type": "boolean", "default": false},
            "attribution": {"type": "string"}
          }
        }
      }
    },
    "action_effects": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["target", "magnitude"],
          "additionalProperties": false,
          "properties": {
            "target": {"type": "string", "minLength": 1},
            "magnitude": {"type": "number"},
            "lag": {"type": "integer", "minimum": 0, "default": 0},
            "op": {"type": "string", "enum": ["add"], "default": "add"}
          }
        }
      }
    },
    "payoffs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state_weights", "utility_table"],
        "additionalProperties": false,
        "properties": {
          "state_weights": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          },
          "utility_table": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          },
          "attribution": {"type": "string"}
        }
      }
    }
  }
}
